# Spartan-3AN Starter Kit - XC3S700AN-FGG484
NET "clk" LOC = "E12" | IOSTANDARD = LVCMOS33;
NET "clk" PERIOD = 20 ns HIGH 40%;
NET "confirm_btn" LOC = "T14" | IOSTANDARD = LVCMOS33 | PULLDOWN;
NET "reset_btn" LOC = "T15" | IOSTANDARD = LVCMOS33 | PULLDOWN;
NET "sw<0>" LOC = "V8" | IOSTANDARD = LVCMOS33;
NET "sw<1>" LOC = "U10" | IOSTANDARD = LVCMOS33;
NET "sw<2>" LOC = "U8" | IOSTANDARD = LVCMOS33;
NET "sw<3>" LOC = "T9" | IOSTANDARD = LVCMOS33;
NET "led_result<0>" LOC = "R20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led_result<1>" LOC = "T19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led_result<2>" LOC = "U20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led_result<3>" LOC = "U19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led_zero" LOC = "V19" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led_negative" LOC = "V20" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led_carry" LOC = "Y22" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
NET "led_overflow" LOC = "W21" | IOSTANDARD = LVCMOS33 | SLEW = SLOW | DRIVE = 8;
